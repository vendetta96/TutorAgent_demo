# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# Models (all OpenAI). Defaults shown.
OPENAI_LLM_MODEL=gpt-4o
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Presentation pacing (seconds)
SLIDE_GAP_SECS=1.2        # silence after a slide before the next one starts
STALL_SECS=8              # nudge the LLM if nothing happens while presenting
QNA_IDLE_SECS=25          # in Q&A, ask "any questions?" after this much silence
MAX_IDLE_PROMPTS=2        # ...then say goodbye and end

# Knowledge retrieval
RETRIEVAL_K=3
RETRIEVAL_MIN_SCORE=0.35

# Optional: also run student messages through OpenAI's moderation endpoint
SAFETY_USE_MODERATION_API=false
